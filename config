# ngx_http_securelog_module - build config
# Supports both --add-module (static) and --add-dynamic-module (dynamic)

ngx_addon_name=ngx_http_securelog

if test -n "$ngx_module_link"; then
    # -- Dynamic module build (--add-dynamic-module) ----------------------
    ngx_module_type=HTTP
    ngx_module_name=ngx_http_securelog
    ngx_module_incs=
    ngx_module_deps=
    ngx_module_srcs="$ngx_addon_dir/src/ngx_http_securelog.c"
    ngx_module_libs="-lgpgme -lcrypto -ldl"
    ngx_module_order="$ngx_module_name ngx_http_log_module"

    . auto/module
else
    # -- Static build (--add-module) ---------------------------------------
    HTTP_MODULES="$HTTP_MODULES ngx_http_securelog"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $ngx_addon_dir/src/ngx_http_securelog.c"
    CORE_LIBS="$CORE_LIBS -lgpgme -lcrypto -ldl"
    # Ensure this module runs before the default log module
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS $ngx_addon_dir/src/ngx_http_securelog.c"
fi
